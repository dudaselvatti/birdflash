rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /codeds/{codedId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid in [
          "hDN8IUQ0kJW29pS2n0ukDRBaS4J3",
          "0sKeNdvbFWPtDKUFiNyp2Brtqvk1"
        ];
    }
  }
}
